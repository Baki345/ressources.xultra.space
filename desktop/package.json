{
  "name": "xultra-desktop",
  "version": "1.0.2",
  "description": "Application de bureau XULTRA — enveloppe native pour xultra.space",
  "main": "src/main.js",
  "private": true,
  "author": {
    "name": "XULTRA",
    "email": "contact@xultra.space"
  },
  "homepage": "https://xultra.space",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Baki345/ressources.xultra.space.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "space.xultra.desktop",
    "productName": "XULTRA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/tray@16.png",
      "build/badges/**/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;Chat;",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "contact@xultra.space"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
