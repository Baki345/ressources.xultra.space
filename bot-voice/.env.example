# Token secret du bot (Paramètres → Mes bots → "Bot Vocal" → copier le token)
BOT_TOKEN=x1bot_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port HTTP local sur lequel le bot écoute /interactions et /events
PORT=3000

# Ne change ces deux valeurs que si tu pointes vers une autre instance X1.
X1_BASE_URL=https://xultra.space
LIVEKIT_WS_URL=wss://voice.xultra.space

# Dossier où les enregistrements (.wav, un fichier par personne) sont écrits.
RECORDINGS_DIR=./recordings

# Chemins des binaires si non trouvés automatiquement dans le PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
