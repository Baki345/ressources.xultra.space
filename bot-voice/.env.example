# Token secret du bot (Paramètres → Mes bots → "Bot Vocal" → copier le token)
BOT_TOKEN=x1bot_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port HTTP local sur lequel le bot écoute /interactions et /events
PORT=3000

# Ne change ces deux valeurs que si tu pointes vers une autre instance X1.
X1_BASE_URL=https://xultra.space
LIVEKIT_WS_URL=wss://voice.xultra.space

# Dossier où les enregistrements (.wav, un fichier par personne) sont écrits.
RECORDINGS_DIR=./recordings

# Chemins des binaires si non trouvés automatiquement dans le PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Dashboard web (facultatif — laisse ces 3 lignes vides pour le désactiver,
# le bot fonctionne très bien par commandes seules sans ça).
# PUBLIC_URL = l'URL HTTPS publique de CE bot (celle mise dans "URL
# d'interactions" côté X1, sans le /interactions à la fin).
# OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET = créés dans Paramètres → Se
# connecter avec X1 → + Créer une application, avec comme URL de
# redirection : <PUBLIC_URL>/oauth/callback
PUBLIC_URL=https://mon-bot.exemple.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Signe les cookies de session du dashboard — génère une valeur aléatoire
# toi-même (ex. openssl rand -hex 32) pour que les sessions survivent un
# redémarrage du bot ; sinon une valeur temporaire est générée à chaque
# démarrage (ce qui déconnecte tout le monde à chaque redémarrage).
DASHBOARD_SECRET=
