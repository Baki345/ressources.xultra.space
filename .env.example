# Copiez ce fichier en .env et remplissez les valeurs sur votre VPS Contabo.
# Sans ces variables, les pieces jointes sont stockees localement dans
# data/attachments/ (fonctionne aussi tres bien pour un usage familial).

NODE_ENV=production
PORT=3000

# --- Bunny Storage + CDN (optionnel, pour les pieces jointes a grande echelle) ---
# Storage zone : creez-en une sur panel.bunny.net > Storage
BUNNY_STORAGE_ZONE=
# Cle d'acces de la storage zone (secret, ne jamais commiter)
BUNNY_STORAGE_ACCESS_KEY=
# Host de la region de la storage zone, ex: storage.bunnycdn.com ou ny.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# URL de la pull zone (CDN) reliee a cette storage zone, ex: https://votre-zone.b-cdn.net
BUNNY_PULL_ZONE_URL=
