# À copier vers /etc/nginx/sites-available/appwrite.xultra.space puis
# symlinker dans sites-enabled/ et lancer `certbot --nginx -d appwrite.xultra.space`
# (certbot réécrira ce fichier pour ajouter le bloc TLS + le serveur 443).

server {
    listen 80;
    listen [::]:80;
    server_name appwrite.xultra.space;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 5G; # Appwrite Storage accepte de gros fichiers
    }
}
