{
  "expo": {
    "name": "XULTRA",
    "slug": "xultra-mobile",
    "scheme": "xultra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "space.xultra.mobile",
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "package": "space.xultra.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "XULTRA a besoin d'accéder à vos photos pour les envoyer en pièce jointe chiffrée dans vos messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "XULTRA a besoin d'accéder à votre microphone pour vous permettre de parler dans les salons vocaux.",
          "cameraPermission": "XULTRA n'utilise pas encore la caméra — cette permission est déclarée par la bibliothèque d'appel vocal mais n'est pas encore branchée à une fonctionnalité vidéo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f928e598-c48c-4fb1-bff4-1144a890f9cd"
      }
    },
    "owner": "ciscodev7"
  }
}
