# Secret partagé avec IXin — DOIT être EXACTEMENT la même valeur que le
# secret Cloudflare Worker VPN_MANAGER_SECRET côté worker.js (Workers →
# bitter-violet-3f1a → Settings → Variables). Génère une valeur aléatoire
# (ex. openssl rand -hex 32), jamais un mot choisi.
VPN_MANAGER_SECRET=

# Clé publique WireGuard du SERVEUR (pas d'un client) — contenu du fichier
# /etc/wireguard/server_public.key généré à l'installation (voir README.md
# § Installation WireGuard). Nécessaire pour construire les .conf clients.
WG_SERVER_PUBLIC_KEY=

# host:port public que les appareils des abonnés doivent joindre — l'IP (ou
# le nom DNS) de CE VPS, port WireGuard choisi à l'installation (51820 par
# défaut). PAS forcément vpn.xultra.space (ce nom peut ne servir qu'à une
# page de statut humaine, le trafic WireGuard lui-même n'en a pas besoin).
WG_ENDPOINT=203.0.113.10:51820

# Port HTTP local sur lequel ce service écoute POST /sync.
PORT=3100

# Base de l'API IXin à interroger (laisser la valeur par défaut en prod).
IXIN_BASE_URL=https://xultra.space

# Interface WireGuard gérée par ce service — doit déjà être montée
# (wg-quick up wg0) avant de démarrer ce service.
WG_INTERFACE=wg0

# Sous-réseau dans lequel une adresse /32 est allouée par abonné — DOIT
# correspondre à Address= dans wg0.conf, et ne DOIT RIEN chevaucher d'autre
# sur ce VPS (vérifier `ip a` et `docker network ls` avant de choisir : un
# conflit avec le réseau Docker d'Appwrite casserait les deux services).
WG_SUBNET_CIDR=10.66.0.0/24

# DNS renseigné dans les .conf clients.
WG_CLIENT_DNS=1.1.1.1
